+    /// #     fn fetch(&mut self, _r: &[Self::RefSpec]) -> Result<(), VctrlError> { Ok(()) }
+    /// #     fn push(&mut self, _r: &[Self::RefSpec]) -> Result<(), VctrlError> { Ok(()) }
